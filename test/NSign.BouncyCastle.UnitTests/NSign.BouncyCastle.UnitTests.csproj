<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(TestTargetFrameworks)</TargetFrameworks>
    <RootNamespace>NSign.BouncyCastle</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="$(CoverletCollectorVersionWildcard)" />
    <PackageReference Include="coverlet.MTP" Version="$(CoverletCollectorVersionWildcard)" />
    <PackageReference Include="xunit.v3" Version="$(XunitVersionWildcard)" />
  </ItemGroup>

  <ItemGroup Label="netstandard target" Condition="'$(TestTargetsNetStandard)' == 'true'">
    <!-- Set the library project reference to target the designated netstandard target -->
    <ProjectReference Include="..\..\src\NSign.BouncyCastle\NSign.BouncyCastle.csproj">
      <SetTargetFramework>TargetFramework=$(NetStandardTarget)</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Label="netX targets" Condition="'$(TestTargetsNetStandard)' != 'true'">
    <ProjectReference Include="..\..\src\NSign.BouncyCastle\NSign.BouncyCastle.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="*-priv.pem;*-pub.pem">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
